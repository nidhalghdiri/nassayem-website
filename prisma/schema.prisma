// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL") // Required for Supabase to bypass connection pooling for migrations
}

// ------------------------------------------------------
// ENUMS — Property rental
// ------------------------------------------------------

enum UnitType {
  STUDIO
  ONE_BEDROOM
  TWO_BEDROOM
  THREE_BEDROOM
  VILLA
}

enum RentType {
  DAILY
  MONTHLY
  BOTH
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUNDED
}

enum NetsuitePaymentStatus {
  PENDING // Link created, customer has not paid yet
  PAID // SmartPay confirmed payment success
  FAILED // SmartPay declined / cancelled
  EXPIRED // Link expired before customer paid
  VOIDED // Manually voided by admin
}

// ------------------------------------------------------
// ENUMS — Staff & Task management
// ------------------------------------------------------

enum StaffRole {
  MANAGER
  SUPERVISOR
  RECEPTIONIST
  HOUSEKEEPING
  MAINTENANCE
  LAUNDRY // Laundry-place operator — receives, processes and marks laundry ready
}

// ------------------------------------------------------
// ENUMS — Laundry management
// ------------------------------------------------------

// Lifecycle of a laundry order as it moves through the custody chain:
// Receptionist → Supervisor → Laundry man → Supervisor → Receptionist.
// A counted quantity is captured at each handoff so a missing piece can be
// pinned to the exact leg where it disappeared.
enum LaundryStatus {
  REQUESTED // Receptionist submitted; supervisor collects and brings to laundry
  AT_LAUNDRY // Laundry man confirmed receipt, pending process
  PROCESSING // Laundry man is washing
  READY // Finished, ready for the supervisor to collect
  OUT_FOR_DELIVERY // Supervisor collected ready laundry, en route to building
  DELIVERED // Receptionist received & verified counts — order done
  CANCELLED
}

enum TaskType {
  CLEANING
  INSPECTION
  MAINTENANCE
  WORK_ORDER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Unified status enum — valid values depend on TaskType (enforced in app logic)
enum TaskStatus {
  ASSIGNED // Task created and assigned, work not started
  CLEANING_STARTED
  CLEANING_COMPLETED
  INSPECTING
  ISSUES_FOUND
  NO_ISSUES
  WORK_STARTED
  WORK_COMPLETED
  IN_PROGRESS // Work Order
  COMPLETED // Work Order final
  ON_HOLD
  CANCELLED
}

// ------------------------------------------------------
// ENUMS — AI Chatbot
// ------------------------------------------------------

enum ChatChannel {
  WHATSAPP
  WEB
}

enum ChatMessageRole {
  USER
  ASSISTANT
  STAFF // human agent message sent from the admin panel (handoff mode)
  TOOL // one row per executed tool call — payload holds { input, result }
}

enum ChatConversationStatus {
  ACTIVE
  ESCALATED // flagged for human takeover — surfaced in the admin panel
  CLOSED
}

enum ChatLeadStatus {
  NEW
  CONTACTED
  CONVERTED
  LOST
}

enum ChatHoldStatus {
  ACTIVE
  EXPIRED
  CONVERTED // customer completed a real booking
  CANCELLED
}

// ------------------------------------------------------
// ENUMS — Recommendations
// ------------------------------------------------------

enum RecommendationCategory {
  BEACH
  MOUNTAIN
  WATERFALL
  WADI
  CULTURAL
  RESTAURANT
  EVENT
  ACTIVITY
  OTHER
}

// ------------------------------------------------------
// MODELS — Property rental
// ------------------------------------------------------

model Building {
  id            String  @id @default(uuid())
  nameEn        String
  nameAr        String
  // Short internal label used across the admin (Tasks, Laundry) in place of the
  // long public website name. Optional — falls back to nameEn/nameAr when empty.
  shortName     String?
  locationEn    String
  locationAr    String
  latitude      Float?
  longitude     Float?
  descriptionEn String?
  descriptionAr String?
  imageUrl      String?

  // Links this website building to its counterpart in NetSuite. Set in the
  // admin Buildings form; matched against the building id NetSuite sends with
  // each payment link so receptionists can be scoped to their building(s).
  netsuiteId String? @unique

  // Relations
  units               Unit[]
  tasks               Task[]
  assignedStaff       AdminUserBuilding[]
  promotionRows       PromotionRow[]
  unitTypeDailyPrices UnitTypeDailyPrice[]
  netsuitePayments    NetsuitePayment[]
  laundryOrders       LaundryOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Unit {
  id         String @id @default(uuid())
  buildingId String

  unitCode      String? @unique
  titleEn       String
  titleAr       String
  descriptionEn String  @db.Text
  descriptionAr String  @db.Text

  unitType UnitType
  rentType RentType

  dailyPrice   Float?
  monthlyPrice Float?

  guests    Int @default(1)
  bedrooms  Int @default(1)
  beds      Int @default(1)
  bathrooms Int @default(1)

  // Number of identical interchangeable rooms backing this listing.
  // The unit can be booked concurrently up to this count for any given night.
  inventoryCount Int @default(1)

  isPublished Boolean @default(false)

  // Relations
  building       Building                 @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  images         UnitImage[]
  amenities      Amenity[]
  bookings       Booking[]
  priceOverrides UnitDailyPriceOverride[]
  chatbotLeads   ChatbotLead[]
  chatbotHolds   ChatbotHold[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UnitImage {
  id           String  @id @default(uuid())
  unitId       String
  url          String
  isMain       Boolean @default(false)
  displayOrder Int     @default(0)

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Amenity {
  id      String  @id @default(uuid())
  nameEn  String  @unique
  nameAr  String  @unique
  iconSvg String?

  units Unit[]

  createdAt DateTime @default(now())
}

model Booking {
  id          String  @id @default(uuid())
  bookingCode String? @unique // Short human-readable ID, e.g. NSM-K4X7Q2
  unitId      String

  guestName        String
  guestEmail       String
  guestPhone       String
  guestNationality String?
  guestNotes       String?
  paymentMethod    String  @default("CARD") // CASH or CARD

  // Payment plan — FULL = pay totalPrice online; ADVANCE_50 = pay 50% online,
  // collect the rest at reception. Only meaningful for CARD bookings.
  paymentPlan        String @default("FULL") // FULL or ADVANCE_50
  amountPaid         Float? // what SmartPay actually charged (or what was paid in cash)
  amountDueAtCheckIn Float  @default(0) // balance reception must collect

  checkIn    DateTime
  checkOut   DateTime
  totalPrice Float
  status     BookingStatus @default(PENDING)

  // SmartPay transaction traces — populated by the webhook on a successful
  // CARD payment. `paidAt` is the exact transaction time (indexed so the
  // admin list can filter/sort by payment date). `smartpayRawResponse` holds
  // the full decrypted gateway response; all bank fields shown in the admin
  // UI (order_id, tracking_id, bank_ref_no, card number…) are extracted from
  // it at read time via lib/smartpayFields. Both are null for cash bookings
  // and for card bookings paid before these fields existed.
  paidAt              DateTime?
  smartpayRawResponse Json?

  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paidAt])
}

// ------------------------------------------------------
// MODELS — Pricing (daily rates by unit type + per-unit overrides)
// ------------------------------------------------------

// Base daily rate per (Building, UnitType, Date). Default used when no
// per-unit override exists. Mass-imported from CSV; edited via grid.
model UnitTypeDailyPrice {
  id         String   @id @default(uuid())
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitType   UnitType
  date       DateTime @db.Date
  dailyPrice Decimal  @db.Decimal(10, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([buildingId, unitType, date])
  @@index([buildingId, unitType, date])
}

// Optional per-Unit override. Takes precedence over UnitTypeDailyPrice
// for the same date when present.
model UnitDailyPriceOverride {
  id         String   @id @default(uuid())
  unitId     String
  unit       Unit     @relation(fields: [unitId], references: [id], onDelete: Cascade)
  date       DateTime @db.Date
  dailyPrice Decimal  @db.Decimal(10, 3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([unitId, date])
  @@index([unitId, date])
}

// ------------------------------------------------------
// MODELS — Promotions
// ------------------------------------------------------

model Promotion {
  id            String   @id @default(uuid())
  titleEn       String
  titleAr       String
  descriptionEn String?  @db.Text
  descriptionAr String?  @db.Text
  imageUrl      String?
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean  @default(true)

  rows PromotionRow[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, startDate, endDate])
}

model PromotionRow {
  id          String    @id @default(uuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  // null = applies to ALL buildings / ALL unit types
  buildingId String?
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  unitType   UnitType?

  regularPrice Float
  promoPrice   Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([promotionId])
  @@index([buildingId])
  @@index([unitType])
}

// ------------------------------------------------------
// MODELS — NetSuite payment links (off-website reservations)
// ------------------------------------------------------

model NetsuitePayment {
  id    String @id @default(uuid())
  token String @unique // public URL token (random, unguessable)

  // NetSuite reservation context (provided by NetSuite when link is created)
  netsuiteReservationId  String // internal NetSuite record id
  netsuiteReservationRef String? // human-readable reservation number, e.g. "RES-2026-00412"
  unitCode               String? // e.g. "OK-305"
  checkIn                DateTime?
  checkOut               DateTime?

  // Building scope. netsuiteBuildingId is the raw building id NetSuite sends;
  // buildingId is the resolved website Building (matched via Building.netsuiteId)
  // and is what receptionist views filter on. Null when no match is found.
  netsuiteBuildingId String?
  buildingId         String?
  building           Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  // Customer details (provided by NetSuite, may be confirmed/edited on the public page)
  customerName  String
  customerPhone String?
  customerEmail String? // collected on the public page if NetSuite did not send it

  // Payment details
  amount      Float // amount the customer will be charged
  currency    String  @default("OMR")
  description String? // free-text shown to the customer

  // Receptionist who triggered the link (for notification emails)
  receptionistEmail String?
  receptionistName  String?

  // Lifecycle
  status    NetsuitePaymentStatus @default(PENDING)
  expiresAt DateTime
  paidAt    DateTime?

  // Soft-delete flag — false = hidden from the default list, manager only.
  isActive Boolean @default(true)

  // SmartPay traces. The full decrypted gateway response is kept in
  // smartpayRawResponse; tracking_id, card number, payment mode, etc. are
  // extracted from it at read time via lib/smartpayFields.
  smartpayOrderId     String? @unique
  smartpayBankRefNo   String?
  smartpayRawResponse Json?

  // NetSuite sync trace
  netsuiteSyncedAt  DateTime?
  netsuiteSyncError String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([netsuiteReservationId])
  @@index([createdAt])
  @@index([buildingId])
}

// ------------------------------------------------------
// MODELS — Admin users & Task management
// ------------------------------------------------------

model AdminUser {
  id                String    @id @default(uuid())
  supabaseId        String?   @unique
  email             String    @unique
  passwordHash      String?
  name              String?
  role              StaffRole @default(MANAGER)
  whatsappNumber    String? // e.g. "96898590405" — no + or spaces
  preferredLanguage String    @default("en") // "en" or "ar"

  // Task relations
  createdTasks   Task[]         @relation("TaskCreatedBy")
  assignedTasks  Task[]         @relation("TaskAssignedTo")
  taskNotes      TaskNote[]
  taskPhotos     TaskPhoto[]
  taskActivities TaskActivity[]
  posts          Post[]

  // Laundry relations
  laundryRequested  LaundryOrder[] @relation("LaundryRequestedBy")
  laundrySupervised LaundryOrder[] @relation("LaundrySupervisor")
  laundryProcessed  LaundryOrder[] @relation("LaundryUser")
  laundryEvents     LaundryEvent[]

  // Receptionist building scope
  assignedBuildings AdminUserBuilding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Receptionist ↔ Building scope (many-to-many)
model AdminUserBuilding {
  adminUserId String
  buildingId  String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  building    Building  @relation(fields: [buildingId], references: [id], onDelete: Cascade)

  @@id([adminUserId, buildingId])
  @@index([adminUserId])
}

model Task {
  id          String   @id @default(uuid())
  type        TaskType
  title       String
  description String?  @db.Text

  // Location
  buildingId String
  unitNumber String? // free-text unit name/code, null = common area

  // Priority & status
  priority TaskPriority @default(MEDIUM)
  status   TaskStatus   @default(ASSIGNED)

  // People
  createdById  String
  assignedToId String

  dueDate DateTime

  // Sub-task / parent link (Inspection → spawns Cleaning or Maintenance)
  parentTaskId String?

  // Relations
  building   Building  @relation(fields: [buildingId], references: [id])
  // (no Unit relation — unitNumber is free text)
  createdBy  AdminUser @relation("TaskCreatedBy", fields: [createdById], references: [id])
  assignedTo AdminUser @relation("TaskAssignedTo", fields: [assignedToId], references: [id])
  parentTask Task?     @relation("SubTasks", fields: [parentTaskId], references: [id])
  subTasks   Task[]    @relation("SubTasks")

  notes               TaskNote[]
  photos              TaskPhoto[]
  activities          TaskActivity[]
  inspectionChecklist InspectionChecklist?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([assignedToId])
  @@index([buildingId])
  @@index([dueDate])
  @@index([type])
}

model TaskNote {
  id     String @id @default(uuid())
  taskId String
  userId String
  text   String @db.Text

  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user AdminUser @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

model TaskPhoto {
  id       String  @id @default(uuid())
  taskId   String
  userId   String
  photoUrl String
  caption  String?

  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user AdminUser @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
}

// Auto-generated audit log — one record per meaningful action on a task
model TaskActivity {
  id      String @id @default(uuid())
  taskId  String
  userId  String
  // action: "task_created" | "status_changed" | "note_added" | "photo_uploaded" | "approved" | "rejected"
  action  String
  details String @db.Text

  task Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user AdminUser @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId])
}

// ── Inspection checklist — created automatically for INSPECTION tasks ─────────

model InspectionChecklist {
  id             String                    @id @default(uuid())
  taskId         String                    @unique
  task           Task                      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  items          InspectionChecklistItem[]
  overallRating  String? // "excellent" | "good" | "fair" | "poor"
  inspectorNotes String?                   @db.Text
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model InspectionChecklistItem {
  id          String              @id @default(uuid())
  checklistId String
  checklist   InspectionChecklist @relation(fields: [checklistId], references: [id], onDelete: Cascade)

  category          String
  label             String
  status            String   @default("pending") // "pending" | "pass" | "fail" | "na"
  notes             String?  @db.Text
  severity          String? // "minor" | "major" | "critical"
  photoUrls         String[] @default([])
  displayOrder      Int      @default(0)
  followUpTaskId    String?
  maintenanceTaskId String? // ID of the maintenance task if requested from here

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([checklistId])
}

// ── Custom Inspection Settings ───────────────────────────────────────────────

model InspectionCategory {
  id           String           @id @default(uuid())
  nameEn       String
  nameAr       String
  displayOrder Int              @default(0)
  items        InspectionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InspectionItem {
  id         String             @id @default(uuid())
  categoryId String
  category   InspectionCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  labelEn      String
  labelAr      String
  displayOrder Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------
// MODELS — Laundry management
// ------------------------------------------------------

// Catalog of launderable items (Bed sheet, Pillow case, Carpet, Towel…).
// Bilingual, manager-managed. Receptionists pick from this list when
// requesting laundry instead of typing free text.
model LaundryItemType {
  id           String  @id @default(uuid())
  nameEn       String
  nameAr       String
  iconSvg      String? // optional SVG path for the item icon
  displayOrder Int     @default(0)
  isActive     Boolean @default(true) // false = retired, hidden from new requests

  orderItems LaundryOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, displayOrder])
}

model LaundryOrder {
  id        String @id @default(uuid())
  orderCode String @unique // Short human-readable id, e.g. LDY-K4X7Q2

  // Location
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])

  // People. Pull model — supervisorId / laundryUserId are filled in when a
  // supervisor collects the laundry and when the laundry man receives it.
  requestedById String
  requestedBy   AdminUser  @relation("LaundryRequestedBy", fields: [requestedById], references: [id])
  supervisorId  String?
  supervisor    AdminUser? @relation("LaundrySupervisor", fields: [supervisorId], references: [id])
  laundryUserId String?
  laundryUser   AdminUser? @relation("LaundryUser", fields: [laundryUserId], references: [id])

  priority   TaskPriority  @default(MEDIUM)
  status     LaundryStatus @default(REQUESTED)
  neededDate DateTime // when the receptionist needs the laundry back
  notes      String?       @db.Text

  // Per-stage custody timestamps (null until that handoff occurs)
  atLaundryAt      DateTime?
  processingAt     DateTime?
  readyAt          DateTime?
  outForDeliveryAt DateTime?
  deliveredAt      DateTime?

  // Relations
  items  LaundryOrderItem[]
  events LaundryEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([buildingId])
  @@index([requestedById])
  @@index([neededDate])
}

// One line per item type on an order. The count columns are the discrepancy
// engine: each is filled by the custodian at that handoff, so a missing piece
// can be traced to the exact leg where the count dropped.
model LaundryOrderItem {
  id      String       @id @default(uuid())
  orderId String
  order   LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  // itemTypeId is null for an "Other" line; customName then holds the free-text
  // name the receptionist typed.
  itemTypeId String?
  itemType   LaundryItemType? @relation(fields: [itemTypeId], references: [id])
  customName String?

  requestedQty Int // declared by the receptionist
  atLaundryQty Int? // counted by the laundry man on receipt
  returnedQty  Int? // counted by the supervisor when collecting ready laundry
  deliveredQty Int? // counted by the receptionist on final return

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
}

// Auto-generated audit log — one record per meaningful action on an order.
model LaundryEvent {
  id      String @id @default(uuid())
  orderId String
  userId  String
  // action: "order_created" | "status_changed" | "note_added" | "cancelled"
  action  String
  details String @db.Text

  order LaundryOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  AdminUser    @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())

  @@index([orderId])
}

// ------------------------------------------------------
// MODELS — Blog & Content
// ------------------------------------------------------

model Post {
  id   String @id @default(uuid())
  slug String @unique

  titleEn   String
  titleAr   String
  contentEn String  @db.Text
  contentAr String  @db.Text
  excerptEn String? @db.Text
  excerptAr String? @db.Text

  coverImage  String?
  isPublished Boolean @default(false)

  // Relations
  authorId String?
  author   AdminUser? @relation(fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

// ------------------------------------------------------
// MODELS — AI Chatbot (Claude-powered, web widget + WhatsApp)
// ------------------------------------------------------

// One conversation per customer per channel. externalId is the WhatsApp phone
// number (digits only, e.g. "96899551237") or the web widget's session UUID.
model ChatbotConversation {
  id         String      @id @default(uuid())
  channel    ChatChannel
  externalId String

  customerName String?
  // Detected customer language: "ar" | "en". Arabizi (Arabic in Latin script)
  // is stored as "ar" — the model mirrors the customer's script when replying.
  language     String                 @default("ar")
  status       ChatConversationStatus @default(ACTIVE)
  escalationReason String?
  // Follow-up status for escalated conversations
  escalatedAt      DateTime?
  // "NONE" | "PENDING" | "ASKED" | "CONTACTED" | "NOT_CONTACTED"
  followUpStatus   String @default("NONE")

  // "Stop AI" switch (admin panel). When true, inbound customer messages are
  // still stored for the team to read, but the model is never called and no
  // reply is sent — zero token spend while a human handles the chat.
  aiPaused Boolean @default(false)

  lastMessageAt DateTime @default(now())

  messages ChatbotMessage[]
  leads    ChatbotLead[]
  holds    ChatbotHold[]
  audit    ChatbotConversationAudit?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([channel, externalId])
  @@index([status, lastMessageAt])
  @@index([lastMessageAt])
}

// LLM-graded quality audit — one row per conversation, produced by the
// admin-triggered audit run (/admin/chatbot/insights). Re-audited when the
// conversation gets new messages after auditedAt.
model ChatbotConversationAudit {
  id             String @id @default(uuid())
  conversationId String @unique

  auditedAt DateTime @default(now())
  model     String // model id that produced the verdict

  // Extracted columns for fast aggregation; `issues`/`topics` hold the detail.
  outcome             String // paid | reserved_unpaid | lead_captured | escalated | info_only | abandoned | spam
  funnelStage         Int // 1 started … 8 paid
  sentiment           String // positive | neutral | negative | frustrated
  missedBooking       Boolean @default(false)
  missedBookingReason String?
  reservationCreated  Boolean @default(false)
  paymentStatus       String? // from NetsuitePayment when a reservation was created

  issues Json // [{ tag, evidence, suggested_fix }]
  topics Json // ["parking", "cancellation_policy", ...]

  abandonLastBotMessage String? @db.Text // bot's final message before the customer went silent
  summary               String  @db.Text

  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([outcome])
  @@index([funnelStage])
}

model ChatbotMessage {
  id             String @id @default(uuid())
  conversationId String

  role    ChatMessageRole
  content String          @db.Text // user/assistant text; short summary for TOOL rows

  // WhatsApp inbound message id (wamid) — used to dedupe Meta webhook retries.
  waMessageId String? @unique

  // Media attached to this message (inbound WhatsApp media is mirrored into
  // Supabase storage; staff attachments are uploaded there directly).
  // mediaType: image | video | audio | document | sticker | location | contact
  mediaUrl  String?
  mediaType String?

  // TOOL rows only
  toolName    String?
  toolPayload Json? // { input, result } — full trace for the admin transcript

  // Anthropic usage for cost tracking (assistant rows only, summed across the
  // tool loop for the turn).
  inputTokens  Int?
  outputTokens Int?

  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
  @@index([createdAt])
}

model ChatbotLead {
  id             String @id @default(uuid())
  conversationId String

  name  String
  phone String

  // Structured interest when the bot matched a real unit; free text otherwise.
  unitId       String?
  unitInterest String?

  checkIn  DateTime?
  checkOut DateTime?
  guests   Int?

  // National ID or passport number captured when the customer is ready to book.
  // Stored in its own column so the admin inbox can search leads by it.
  idNumber String?

  // NetSuite reservation number a staff member records after they manually
  // create the reservation (chatbot reservation creation is paused). Searchable
  // from the admin inbox so a conversation can be found by its reservation.
  reservationNumber String?

  status ChatLeadStatus @default(NEW)
  notes  String?        @db.Text

  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  unit         Unit?               @relation(fields: [unitId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Editable bot settings — single source of truth read live by the agent
// (system prompt additions, tone, business rules, escalation triggers, canned
// replies, contact numbers, show_prices toggle). Defaults live in
// lib/chatbot/config.ts; a DB row overrides its default. No redeploy needed.
model ChatbotConfig {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Soft reservation created by the bot (~30 min TTL). Counts against
// availability in CHATBOT answers only — the public checkout flow is
// intentionally untouched. Expiry is lazy: queries filter on expiresAt.
model ChatbotHold {
  id             String @id @default(uuid())
  unitId         String
  conversationId String

  checkIn   DateTime
  checkOut  DateTime
  expiresAt DateTime
  status    ChatHoldStatus @default(ACTIVE)

  unit         Unit                @relation(fields: [unitId], references: [id], onDelete: Restrict)
  conversation ChatbotConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([unitId, status, expiresAt])
  @@index([conversationId])
}

// ------------------------------------------------------
// MODELS — Outbound WhatsApp log
// ------------------------------------------------------

// One row per outbound WhatsApp send, written inside lib/whatsapp.ts at the two
// chokepoints every send passes through (sendTemplate + postWhatsAppPayload).
// Read-only audit trail for /admin/whatsapp-log — nothing reads it back at
// runtime, so logging failures are swallowed and never break a send.
// Read receipts are not messages and are not logged.
model WhatsAppMessageLog {
  id String @id @default(uuid())

  // Recipient, digits only (e.g. "96890960071") — matches AdminUser.whatsappNumber
  // and ChatbotConversation.externalId, which is how the admin page resolves who
  // a row was sent to without denormalising a name here.
  to String

  // template | text | image | location | contact
  kind   String
  // SENT | FAILED | SKIPPED (SKIPPED = missing credentials, no API call made)
  status String

  // Template sends only
  templateName String?
  language     String? // "ar" | "en_US"
  bodyParams   Json? // ordered template body params — carries the escalation detail

  // Free-form sends only
  body     String? @db.Text // text body, or image caption
  mediaUrl String?

  waMessageId String? // wamid returned by Meta on success
  error       String? @db.Text // Meta error payload / network error on failure

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([to, createdAt])
  @@index([status, createdAt])
}

// ------------------------------------------------------
// MODELS — Recommendations (Salalah Khareef guide)
// ------------------------------------------------------

model Recommendation {
  id String @id @default(uuid())

  titleEn       String
  titleAr       String
  descriptionEn String? @db.Text
  descriptionAr String? @db.Text

  category RecommendationCategory @default(OTHER)

  imageUrl String?
  mapUrl   String? // Google Maps share link or any geo URL

  tagsEn String[] @default([]) // e.g. ["Family-friendly", "Free entry"]
  tagsAr String[] @default([])

  displayOrder Int     @default(0)
  isPublished  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category, isPublished, displayOrder])
}
